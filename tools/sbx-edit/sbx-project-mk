#!/bin/bash
# Usage: sbx-project-mk <project_name>
#
# Strict mode: -e stops on the first failed command (but not inside `if` or
# `&&`/`||` tests), -u errors on unset variables, -o pipefail lets a failure
# anywhere in a pipeline count. Append `|| true` to let a command fail on purpose.
set -euo pipefail

ADMIN_USER="root"              # <-- the account you currently SSH in as

die() { echo "Error: $*" >&2; exit 1; }

# Name flows into a username and a path, so keep it strict.
PROJECT_NAME="${1:-}"
[[ "$PROJECT_NAME" =~ ^[a-z0-9][a-z0-9_-]*$ ]] \
    || die "project name must be lowercase alphanumeric, - or _. Usage: $0 <project_name>"

USER_NAME="sbx-$PROJECT_NAME"
USER_HOME="/home/$USER_NAME"

# getent, not /home/$ADMIN_USER, which is wrong for root.
ADMIN_HOME=$(getent passwd "$ADMIN_USER" | cut -d: -f6) || die "unknown admin user '$ADMIN_USER'"
ADMIN_KEYS="$ADMIN_HOME/.ssh/authorized_keys"
[ -n "$ADMIN_HOME" ] && [ -f "$ADMIN_KEYS" ] || die "no authorized_keys for '$ADMIN_USER'"

if id -u "$USER_NAME" &>/dev/null; then
    echo "Environment for '$PROJECT_NAME' already exists."
else
    sudo useradd -m -s /bin/bash "$USER_NAME"
    sudo -u "$USER_NAME" mkdir -p "$USER_HOME/repos"
    # install does mkdir/cp + chown + chmod in a single step.
    sudo install -d -o "$USER_NAME" -g "$USER_NAME" -m 700 "$USER_HOME/.ssh"
    sudo install    -o "$USER_NAME" -g "$USER_NAME" -m 600 "$ADMIN_KEYS" "$USER_HOME/.ssh/authorized_keys"
    echo "Created isolated environment for $PROJECT_NAME"
fi

